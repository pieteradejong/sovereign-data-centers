# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log

# Python (in case tooling is added later)
__pycache__/
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# Node (in case tooling is added later)
node_modules/

# Web app build output
web/node_modules/
web/dist/
.vercel/

# Outreach contact lists. The institutional map is public (see README); files
# naming individuals are not: a public official's work contact is still personal
# data, and a public repo is a scrape target. See DECISIONS.md #26.
#
# Since 2026-09-06 named individuals live in the separate PRIVATE repo
# sovereign-data-centers-contacts, so nothing here should need these rules.
# They stay as a backstop: they cost nothing and they catch the obvious
# mistakes. They are not a licence to keep personal data here again --
# filename-based protection nearly failed twice (DECISIONS.md #26).
**/contacts/
*-contacts.md

# Playwright output
web/test-results/
web/playwright-report/
